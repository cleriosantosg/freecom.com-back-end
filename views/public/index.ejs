<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FREECOM.COM | Vitrine da Economia Local</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="bi bi-shop me-2"></i>FREECOM.COM
      </a>
      <a href="/admin" class="btn btn-outline-light btn-sm">
        <i class="bi bi-gear me-1"></i> Área Administrativa
      </a>
    </div>
  </nav>

  <header class="bg-white py-5 border-bottom shadow-sm">
    <div class="container text-center">
      <h1 class="fw-bold text-success mb-2">Valorize o Comércio e os Produtores Locais</h1>
      <p class="text-muted mb-4">Encontre padarias artesanais, produtos coloniais, alimentação e serviços perto de você.</p>
      <form method="GET" action="/" class="row g-2 justify-content-center">
        <div class="col-md-5">
          <input type="text" name="busca" class="form-control form-control-lg" placeholder="O que você procura hoje?" value="<%= busca || '' %>">
        </div>
        <div class="col-md-3">
          <select name="categoria" class="form-select form-select-lg">
            <option value="Todas">Todas as Categorias</option>
            <% categorias.forEach(cat => { %>
              <option value="<%= cat.nome %>" <%= categoria === cat.nome ? 'selected' : '' %>><%= cat.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-success btn-lg">
            <i class="bi bi-search me-1"></i> Buscar
          </button>
        </div>
      </form>
    </div>
  </header>

  <main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Empreendedores em Destaque</h4>
      <span class="badge bg-success fs-6"><%= empreendedores.length %> encontrado(s)</span>
    </div>

    <div class="row g-4">
      <% if (empreendedores.length === 0) { %>
        <div class="col-12">
          <div class="alert alert-warning text-center">
            Nenhum empreendedor encontrado com os filtros selecionados.
          </div>
        </div>
      <% } %>

      <% empreendedores.forEach(emp => { %>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  <%= emp.categoria %>
                </span>
                <small class="text-muted"><i class="bi bi-geo-alt-fill text-danger"></i> <%= emp.bairro %></small>
              </div>
              <h5 class="card-title fw-bold mb-1"><%= emp.nomeNegocio %></h5>
              <p class="text-muted small mb-2">Por <%= emp.proprietario %></p>
              <p class="card-text text-secondary"><%= emp.descricao || 'Negócio local cadastrado na rede FREECOM.COM.' %></p>
            </div>
            <div class="card-footer bg-white border-top-0 pb-3">
              <a href="https://wa.me/55<%= emp.telefone.replace(/\D/g, '') %>" target="_blank" class="btn btn-outline-success w-100">
                <i class="bi bi-whatsapp me-1"></i> Contatar (<%= emp.telefone %>)
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <footer class="bg-white text-center text-muted py-4 border-top mt-5">
    <small>© 2026 FREECOM.COM Marketplace da Economia Local</small>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>